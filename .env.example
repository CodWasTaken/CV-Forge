# CV Forge can be configured here or from the browser provider panel.
PORT=3000

# Local folder where generated website CVs are written.
# Relative paths are resolved from the project directory. Absolute paths are also supported.
CV_EXPORT_DIR=./exports

# Optional defaults for an OpenAI-compatible provider.
# Example: http://127.0.0.1:1234/v1
AI_PROVIDER_NAME=Custom provider
AI_BASE_URL=
AI_MODEL=
AI_API_STYLE=auto

# Authentication is optional. Leave the key empty and use "none" for no-auth endpoints.
AI_AUTH_TYPE=none
AI_API_KEY=
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer

# Optional JSON object, for example: {"X-Custom-Header":"value"}
AI_EXTRA_HEADERS_JSON={}
AI_TIMEOUT_MS=120000
